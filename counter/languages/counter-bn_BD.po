msgid "%1$d returns, total %2$s"
msgstr "%1$d টি ফেরত, মোট %2$s"

msgid "%1$d sales, total %2$s"
msgstr "%1$d টি বিক্রয়, মোট %2$s"

msgid "%s cannot be sold in a fractional quantity."
msgstr "%s ভগ্নাংশ পরিমাণে বিক্রি করা যাবে না।"

msgid "+ Add field"
msgstr "+ ফিল্ড যোগ করুন"

msgid "1–30"
msgstr "১–৩০"

msgid "31–60"
msgstr "৩১–৬০"

msgid "61–90"
msgstr "৬১–৯০"

msgid "90+"
msgstr "৯০+"

msgid "A %1$s template must include: %2$s"
msgstr "একটি %1$s টেমপ্লেটে অবশ্যই থাকতে হবে: %2$s"

msgid "A PIN must be 4 to 6 digits."
msgstr "পিন অবশ্যই ৪ থেকে ৬ সংখ্যার হতে হবে।"

msgid "A category with this code already exists."
msgstr "এই কোড দিয়ে একটি ক্যাটাগরি ইতিমধ্যে বিদ্যমান।"

msgid "A client UUID is required."
msgstr "একটি ক্লায়েন্ট UUID আবশ্যক।"

msgid "A clock-out cannot be before its own clock-in."
msgstr "ক্লক-আউট তার নিজের ক্লক-ইনের আগে হতে পারে না।"

msgid "A correction writes a new ledger move; it never edits a balance. Pick a reason honestly — \"adjust\" is a generic correction (a miscount, a data-entry fix), \"waste\" and \"damage\" are shrinkage with a cause."
msgstr "একটি সংশোধন একটি নতুন লেজার মুভ লেখে; এটি কখনো ব্যালেন্স এডিট করে না। সৎভাবে একটি কারণ বেছে নিন — \"adjust\" হলো একটি সাধারণ সংশোধন (গণনার ভুল, ডেটা-এন্ট্রির ত্রুটি), \"waste\" এবং \"damage\" হলো কারণসহ ক্ষতি (শ্রিংকেজ)।"

msgid "A field box cannot start outside the label."
msgstr "একটি ফিল্ড বক্স লেবেলের বাইরে থেকে শুরু হতে পারে না।"

msgid "A field box does not fit inside the label."
msgstr "একটি ফিল্ড বক্স লেবেলের ভেতরে ধরে না।"

msgid "A half-day request must be a single date."
msgstr "একটি হাফ-ডে অনুরোধ অবশ্যই একটি নির্দিষ্ট তারিখের হতে হবে।"

msgid "A name and a positive price are required."
msgstr "একটি নাম এবং একটি পজিটিভ মূল্য আবশ্যক।"

msgid "A note is required for an adjustment of this value."
msgstr "এই মানের সমন্বয়ের জন্য একটি নোট আবশ্যক।"

msgid "A payment account is required."
msgstr "একটি পেমেন্ট অ্যাকাউন্ট আবশ্যক।"

msgid "A payment account needs both a name and a code."
msgstr "একটি পেমেন্ট অ্যাকাউন্টের জন্য নাম ও কোড উভয়ই প্রয়োজন।"

msgid "A payroll run for this period already exists."
msgstr "এই সময়কালের জন্য একটি পেরোল রান ইতিমধ্যে বিদ্যমান।"

msgid "A payroll run must name an active payment account."
msgstr "একটি পেরোল রানে অবশ্যই একটি সক্রিয় পেমেন্ট অ্যাকাউন্ট উল্লেখ থাকতে হবে।"

msgid "A price group needs both a name and a code."
msgstr "একটি মূল্য গ্রুপের জন্য নাম ও কোড উভয়ই প্রয়োজন।"

msgid "A purchase order needs at least one line."
msgstr "একটি ক্রয় আদেশে অন্তত একটি লাইন থাকা প্রয়োজন।"

msgid "A recurring expense lands here first. Nothing here affects the profit and loss until confirmed."
msgstr "একটি পুনরাবৃত্ত খরচ প্রথমে এখানে আসে। নিশ্চিত না হওয়া পর্যন্ত এখানে কিছুই লাভ-ক্ষতিকে প্রভাবিত করে না।"

msgid "A sale a terminal could not complete, even after retrying — a deleted product, a variation that no longer exists, or a server rejection that will never resolve on its own. Re-key the sale at the till, or book it manually another way, then resolve the row below."
msgstr "একটি বিক্রয় যা টার্মিনাল পুনঃচেষ্টার পরও সম্পন্ন করতে পারেনি — একটি মুছে ফেলা পণ্য, একটি ভ্যারিয়েশন যা আর নেই, অথবা এমন একটি সার্ভার প্রত্যাখ্যান যা নিজে থেকে কখনো সমাধান হবে না। টিলে বিক্রয়টি আবার এন্ট্রি করুন, অথবা অন্য কোনোভাবে ম্যানুয়ালি হিসাব রাখুন, তারপর নিচের সারিটি সমাধান করুন।"

msgid "A sale that drained a location below zero — two registers, offline at the same time, both sold the last unit. The sale was still accepted; the goods physically left the shop. Reconcile the shortfall (a restock, a write-off, a corrected count) and resolve the row below."
msgstr "একটি বিক্রয় যা একটি লোকেশনের স্টক শূন্যের নিচে নামিয়ে দিয়েছে — দুটি রেজিস্টার, একই সময়ে অফলাইন, উভয়ই শেষ ইউনিটটি বিক্রি করেছে। বিক্রয়টি তবুও গৃহীত হয়েছে; পণ্য বাস্তবে দোকান থেকে চলে গেছে। ঘাটতি মিলিয়ে নিন (পুনরায় স্টক করা, রাইট-অফ, অথবা সংশোধিত গণনা) এবং নিচের সারিটি সমাধান করুন।"

msgid "A similarly-named supplier already exists."
msgstr "একই রকম নামের একজন সরবরাহকারী ইতিমধ্যে বিদ্যমান।"

msgid "A supplier name is required."
msgstr "সরবরাহকারীর নাম আবশ্যক।"

msgid "A template name is required."
msgstr "টেমপ্লেটের নাম আবশ্যক।"

msgid "A unit needs at least a code and a name."
msgstr "একটি এককের জন্য অন্তত একটি কোড ও নাম প্রয়োজন।"

