# Copy to .env.deploy and fill in. .env.deploy is gitignored — keep it that way.
#
# Authentication is by SSH KEY, not password. See docs/DEPLOY.md §1.
# There is deliberately no CNTR_SSH_PASS variable: a password cannot be used
# unattended without either an interactive prompt or storing it in plaintext,
# and both are worse than a key.

CNTR_SSH_HOST=
CNTR_SSH_PORT=
CNTR_SSH_USER=

# Absolute path to the WordPress root on the server
CNTR_WP_PATH=

# Private key used for this deploy. Keep it outside the repo.
CNTR_SSH_KEY=~/.ssh/counter_deploy
